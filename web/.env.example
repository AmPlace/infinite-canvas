# 生产构建始终强制使用托管模式；本地开发默认恢复上游独立模式，按需设为 managed 调试站内体验。
VITE_SITE_MODE=standalone

# 托管站点默认资料（NewAPI 跳转参数与 /api/status 返回值可覆盖这些展示信息）。
VITE_MANAGED_SITE_NAME=阿柴 AI
VITE_MANAGED_HOME_URL=https://www.achai.cc/
VITE_MANAGED_CONSOLE_URL=https://www.achai.cc/dashboard
VITE_MANAGED_RECHARGE_URL=https://www.achai.cc/wallet
